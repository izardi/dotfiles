{
  "manifest_version": 3,
  "name": "Read Aloud (MultiTTS)",
  "version": "1.0.0",
  "description": "Edge 风格的大声朗读，使用 MultiTTS HTTP API 合成语音",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-read-aloud": {
      "suggested_key": { "default": "Alt+R" },
      "description": "开始/停止大声朗读"
    }
  }
}
